# Google AI Studio key — server-side ONLY, never exposed to the browser
GEMINI_API_KEY=

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key — server-side ONLY
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the deployed app (for trainee links), e.g. https://thb-phone-academy.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin unlock code — typing this under "Admin" on a trainee's learning path
# unlocks all modules, drills, and the test for that account (preview mode).
# Leave empty to disable the feature.
ADMIN_UNLOCK_CODE=
