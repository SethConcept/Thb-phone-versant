# Google AI Studio key — server-side ONLY, never exposed to the browser
GEMINI_API_KEY=

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key — server-side ONLY
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the deployed app (for trainee links), e.g. https://thb-phone-academy.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Global admin unlock code — type it once under "Admin" on any learning-path
# sidebar and this device gets a 30-day preview cookie unlocking all modules,
# drills, and the test on every trainee link. Leave empty to disable.
ADMIN_UNLOCK_CODE=
