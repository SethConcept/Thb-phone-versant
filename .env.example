# Google AI Studio key — server-side ONLY, never exposed to the browser
GEMINI_API_KEY=

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key — server-side ONLY
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the deployed app (for trainee links), e.g. https://thb-phone-academy.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Global admin unlock code — type it once under "Admin" on any learning-path
# sidebar and ALL content (modules, drills, the test) unlocks for EVERYONE,
# on every device and trainee link, until "Lock again" is used with the same
# code. Requires the app_settings table (supabase/setup.sql or
# upgrade-global-unlock.sql). Leave empty to disable.
ADMIN_UNLOCK_CODE=
